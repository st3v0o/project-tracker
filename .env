# ─────────────────────────────────────────────────────────────
#  Project Tracker — environment variables
#  Copy this file to .env and fill in the values below.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# Leave DATABASE_URL blank to use a local SQLite file (local.db).
# Set it to a PostgreSQL connection string if you have a Postgres server.
DATABASE_URL=

# Optional: path for the local SQLite database file (default: local.db)
# SQLITE_PATH=local.db

# ── Server ports ──────────────────────────────────────────────
# API server port (default: 8080)
API_PORT=8080

# Web app port (default: 3000)
PORT=3000

# ── AI Features (optional) ────────────────────────────────────
# Add your OpenAI API key to enable AI-powered ticket parsing
# from photos (camera capture) and voice recordings.
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# These are set automatically when OPENAI_API_KEY is provided.
# Leave them blank unless you use a custom OpenAI-compatible endpoint.
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
